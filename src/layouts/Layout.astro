---
const { siteConfig } = Astro.props as {
  siteConfig: {
    title: string
    url: string
    description: string
    keywords: string
    author: string
  }
}

const slotHtml = await Astro.slots.render('default')
let naiveUiCss = ''
const collect = (globalThis as any).__NAIVE_UI_CSSR_COLLECT__
if (typeof collect === 'function') {
  naiveUiCss = collect()
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{siteConfig.title}</title>
	<meta name="description" content={siteConfig.description}>
	<meta name="keywords" content={siteConfig.keywords}>
	<meta name="author" content={siteConfig.author}>
	<meta property="og:type" content="website">
	<meta property="og:url" content={siteConfig.url}>
	<meta property="og:title" content={siteConfig.title}>
	<meta property="og:description" content={siteConfig.description}>
	<meta property="twitter:card" content="summary_large_image">
	<meta property="twitter:url" content={siteConfig.url}>
	<meta property="twitter:title" content={siteConfig.title}>
	<meta property="twitter:description" content={siteConfig.description}>
	<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
	<link rel="canonical" href={siteConfig.url} />
	<link rel="sitemap" href="/sitemap-index.xml" />
	<script defer src="https://analysis.limulu.moe/script.js" data-website-id="6ba20ea2-a086-4dc2-a036-7351fcad7888"></script>
	{naiveUiCss ? <Fragment set:html={naiveUiCss} /> : null}
</head>
<body>
	<Fragment set:html={slotHtml} />
</body>
</html>
