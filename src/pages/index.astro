---
import Layout from '../layouts/Layout.astro';
import NavSite from '../components/NavSite.vue';
import RandomRecommend from '../components/RandomRecommend.vue';
import { announcementConfig } from '../config/announcement';
import { homeBannerConfig } from '../config/homeBanner';
import { siteConfig } from '../../astro.config.mjs';
import navData from '../data/nav-data.json';
import '../styles/nav-site.css';
---

<Layout siteConfig={siteConfig}>
	<NavSite 
		client:load
		site-title={siteConfig.title}
		announcement={announcementConfig} 
		home-banner={homeBannerConfig} 
		nav-links={navData.navLinks}
	>
		<RandomRecommend slot="random-recommend" client:only="vue" nav-links={navData.navLinks} />
	</NavSite>
</Layout>
